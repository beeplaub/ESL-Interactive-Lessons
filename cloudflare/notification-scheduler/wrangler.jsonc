{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brenup-notification-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "BRENUP_ORIGIN": "https://www.brenup.com"
  },
  "secrets": {
    "required": ["CRON_SECRET"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
