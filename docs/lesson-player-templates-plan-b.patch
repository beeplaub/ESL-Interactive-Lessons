+  const practice = practiceCount ?? 0;
+  if (learn === 0 && practice === 0) return { state: "EMPTY" as const };
+  if (learn > 0 && practice === 0 && ["LAP", "LTP"].includes(lesson.lesson_template ?? "LAP")) return { state: "LEARN_ONLY" as const };
+  if (practice > 0 && learn === 0 && ["LAP", "LTP"].includes(lesson.lesson_template ?? "LAP")) return { state: "PRACTICE_ONLY" as const };
+  return { state: "READY" as const };
+}
