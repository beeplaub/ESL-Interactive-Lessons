NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public site URL used for auth links in server-side integrations.
NEXT_PUBLIC_SITE_URL=https://www.brenup.com

# GA4 Measurement ID, for example G-ABC1234567. Leave blank to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
GEMINI_CONVERSATION_MODEL=gemini-3.1-flash-live-preview
CRON_SECRET=

# Brevo transactional email is configured in Supabase Auth > SMTP.
# Keep the SMTP key in Supabase/Vercel server configuration; never use NEXT_PUBLIC_.
# BREVO_API_KEY=

# Google Gemini AI Config (Free Tier Studio model defaults)
GEMINI_API_KEY=
GEMINI_TTS_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.5-flash
AI_DAILY_LEARNER_LIMIT=15
AI_DAILY_CREATOR_LIMIT=50
# Weighted AI credits replace flat request counting after the AI efficiency migration.
AI_DAILY_LEARNER_CREDITS=30
AI_DAILY_CREATOR_CREDITS=100

# Optional mobile oral-response transcription through Groq. Keep the key server-only.
GROQ_STT_ENABLED=false
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_API_KEY=
# Optional Groq text model for oral, writing, and dialogue feedback.
GROQ_TEXT_MODEL=openai/gpt-oss-20b
